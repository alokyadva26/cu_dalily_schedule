# Supabase PostgreSQL Direct / Pooler JDBC Configuration
# Example for direct connection:
# DB_HOST=db.your-supabase-project-ref.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_database_password
# DB_SSL=true

# Example for Supabase Transaction Pooler:
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.your-supabase-project-ref
# DB_PASSWORD=your_database_password
# DB_SSL=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_SSL=false
